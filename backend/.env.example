# Окружение приложения
ENVIRONMENT=development

# База данных (SQLite по умолчанию, для прод. рекомендуется PostgreSQL)
# Пример для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://finance:finance@db:5432/finance
DATABASE_URL=sqlite+aiosqlite:///./finance.db

# JWT
SECRET_KEY=change-me-in-production
REFRESH_SECRET_KEY=change-me-too-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (через запятую, или * для всех)
CORS_ORIGINS=*

# MinIO / S3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=avatars
S3_REGION=us-east-1

# Стартовый администратор (создаётся при /api/setup_db)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
