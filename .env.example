# --- Общее ---
ENVIRONMENT=production

# --- PostgreSQL ---
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=please-generate-a-random-secret-here
REFRESH_SECRET_KEY=please-generate-a-random-refresh-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=*
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# --- MinIO ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_NAME=avatars
# Под каким URL аватары видны браузеру (host со стороны клиента, не контейнера)
S3_PUBLIC_URL=http://localhost:9000

# --- Frontend ---
FRONTEND_PORT=8080
